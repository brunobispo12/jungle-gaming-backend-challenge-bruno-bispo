{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/bootstrap/main.ts",
    "dev": "bun run --watch src/bootstrap/main.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down -v",
    "load:down": "docker compose -f docker-compose.load.yml down -v",
    "infra:clean": "docker compose down -v && docker compose -f docker-compose.test.yml down -v && docker compose -f docker-compose.load.yml down -v",
    "migrate:up": "bun run scripts/migrate.ts up",
    "migrate:down": "bun run scripts/migrate.ts down",
    "migrate:fresh": "bun run scripts/migrate.ts fresh",
    "test": "bun test test/unit test/load/metrics.spec.ts",
    "test:integration": "bun run scripts/test-integration.ts",
    "test:concurrency": "bun run scripts/test-concurrency.ts",
    "test:load": "bun run scripts/test-load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "decimal.js": "^10.4.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4",
    "typescript": "^5.6.0"
  }
}

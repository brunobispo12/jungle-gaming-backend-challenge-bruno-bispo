# Configuração para rodar a aplicação FORA do Docker Compose, contra a
# infraestrutura que `bun run infra:up` deixa no ar. Dentro do Compose estas
# variáveis já vêm definidas em docker-compose.yml e este arquivo não é lido.
#
# Uso: cp .env.example .env

# --- PostgreSQL ---------------------------------------------------------
# Role de runtime: sem DDL e sem DELETE em tabela financeira.
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5432/wagering
# Credencial de migration: a única que altera schema. É a única variável que
# os comandos migrate:* exigem, com fallback para DATABASE_URL.
DATABASE_MIGRATION_URL=postgres://wagering_migrator:wagering_migrator@localhost:5432/wagering

# --- SQS (LocalStack) ---------------------------------------------------
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ_QUEUE=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

# --- Processo -----------------------------------------------------------
NODE_ENV=development
PORT=3000
# Identifica a instância nos logs e no lease do publisher da outbox.
INSTANCE_ID=local

# Papéis ativos nesta instância: api, consumer, pending-worker, outbox-publisher.
# Todo papel abre a porta e serve /health/live, /health/ready e /metrics;
# apenas `api` serve a API de negócio.
APP_ROLES=api,consumer,pending-worker,outbox-publisher

# Teto da espera pelo lock da wallet antes de virar falha transitória (503).
# Precisa ficar abaixo do VisibilityTimeout de 60 s da fila de entrada.
WALLET_LOCK_TIMEOUT_MS=20000

# LF is mandatory: the init scripts are mounted into Linux containers, and a
# Windows clone with autocrlf would hand bash the CRLF it refuses.
* text=auto eol=lf

*.sh   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf

bun.lock -diff linguist-generated
